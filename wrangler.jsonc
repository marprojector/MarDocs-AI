{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mardocs",
  "main": ".open-next/worker.js",
  "upload_source_maps": true,
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "mardocs.ammararief.my.id",
      "custom_domain": true
    }
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "ff3932f4bef94148809d498ecdb6c083"
    }
  ],
  "vars": {
    "NEXT_PUBLIC_APP_URL": "https://mardocs.ammararief.my.id",
    "SUPABASE_STORAGE_BUCKET": "mardocs"
  }
}
