DATABASE_URL="postgresql://user:password@your-neon-host/neondb?sslmode=require"

AUTH_GOOGLE_ID=your_google_oauth_client_id
AUTH_GOOGLE_SECRET=your_google_oauth_client_secret
AUTH_GITHUB_ID=your_github_oauth_client_id
AUTH_GITHUB_SECRET=your_github_oauth_client_secret
AUTH_SECRET=your_auth_secret_minimum_32_characters

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Voyage AI API key for embedding generation (RAG)
VOYAGE_API_KEY=

# Supabase Storage (private bucket; use the service-role key only on the server)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_STORAGE_BUCKET=mardocs
